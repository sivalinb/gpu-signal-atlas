{
  "name": "gpu-signal-atlas",
  "version": "1.0.0",
  "description": "Citation-first hybrid RAG for NVIDIA Xid events and DCGM telemetry",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "evaluate:pinecone": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/evaluate-pinecone.ts",
    "analyze": "node --experimental-strip-types scripts/analyze.ts",
    "analyze:llm": "node --experimental-strip-types scripts/analyze-llm.ts",
    "index:build": "node --experimental-strip-types scripts/build-index.ts",
    "index:check": "node --experimental-strip-types scripts/check-index.ts",
    "pinecone:sync": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sync-pinecone.ts",
    "discover:you": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/discover-you-sources.ts",
    "ingest": "node --experimental-strip-types scripts/ingest-source.ts",
    "freshness": "node --experimental-strip-types scripts/freshness.ts",
    "ablate": "node --experimental-strip-types scripts/ablate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components core evaluation lib scripts",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@emnapi/wasi-threads": "1.2.3"
  },
  "type": "module"
}
